DATABASE_URL=sqlite:///./dev.db
# ตัวอย่างสำหรับ Postgres (ใช้ตอน docker compose):
# DATABASE_URL=postgresql://postgres:postgres@db:5432/activity_lake

# ใส่ค่าสุ่มของตัวเองใน .env จริง ห้ามใช้ค่าตัวอย่างนี้ (ใครรู้ค่านี้ก็ปลอม token ได้)
# สร้างด้วย: openssl rand -hex 32
JWT_SECRET=<generate-with-openssl-rand-hex-32>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=*

# ---- Object storage: MinIO (Bronze layer) ----
# storage_backend: minio (ปกติ) หรือ memory (สำหรับรัน/ทดสอบโดยไม่มี MinIO)
STORAGE_BACKEND=minio
# ตอนรันด้วย docker compose ใช้ host ของ service = minio:9000
# ตอนรัน backend นอก docker ให้ชี้มาที่ localhost:9000
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_BRONZE=bronze

# ---- OCR (Silver layer) ----
# ocr_backend: easyocr (ประมวลผลจริง Thai+English บน CPU) หรือ stub (ไม่ทำ OCR
# สำหรับรัน/ทดสอบบนเครื่องที่ไม่ได้ติดตั้งโมเดล)
OCR_BACKEND=easyocr
OCR_LANGUAGES=th,en
# เกณฑ์ auto-approve (Phase 14): อนุมัติเองเมื่อมั่นใจสูงและข้อความตรงพอ
OCR_AUTO_CONFIDENCE=0.6
OCR_AUTO_MATCH=0.7

# ---- เช็กอินหน้างานด้วย QR ----
# URL ของหน้าเว็บนิสิตที่ QR จะชี้ไป — QR เก็บ URL เต็มเพื่อให้กล้องมือถือปกติ
# ขึ้นปุ่ม "เปิดลิงก์" ได้ ตอน deploy ต้องเป็นโดเมนจริง + HTTPS
# (เช่น https://activity.tsu.ac.th) ไม่งั้นมือถือเครื่องอื่นเปิดไม่ถึง
PUBLIC_APP_BASE_URL=http://localhost:8080
# ช่วงเวลาที่นิสิตสแกน QR เช็กอินได้: เปิดก่อนกิจกรรมเริ่มกี่นาที และปิดหลัง
# กิจกรรมจบ (start_at + activity.hours) อีกกี่นาที
CHECKIN_OPEN_BEFORE_MINUTES=60
CHECKIN_CLOSE_AFTER_MINUTES=180

# ---- Chatbot (LLM + RAG, Phase 16) ----
# llm_backend: gemini (เรียก Gemini API จริง ต้องมี GEMINI_API_KEY) หรือ stub
# (ทำงานออฟไลน์ ผลลัพธ์คงที่ ใช้ตอนทดสอบ/รันโดยไม่มี key)
LLM_BACKEND=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=models/gemini-embedding-001
# vector_backend: memory (cosine ในหน่วยความจำ ใช้กับ SQLite/เทสต์) หรือ
# pgvector (Postgres extension สำหรับใช้งานจริง)
VECTOR_BACKEND=memory
RAG_TOP_K=4

# ---- อีเมลแจ้งเตือนอัตโนมัติ (ข้อ 6.4) ----
# email_backend: smtp (ส่งจริง) หรือ stub (ไม่ส่งจริง เก็บไว้ในหน่วยความจำ)
# ดีฟอลต์เป็น stub เพื่อไม่ให้ระบบที่ยังตั้งค่าไม่เสร็จเผลอยิงอีเมลถึงนิสิตทั้งมหาวิทยาลัย
EMAIL_BACKEND=stub
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@tsu.ac.th
SMTP_USE_TLS=true
# ต่ำกว่ากี่ % ของชั่วโมงที่ต้องได้ ถือว่าเป็นกลุ่มเสี่ยง (ค่าเดียวกับดีฟอลต์ของแดชบอร์ด)
NOTIFY_AT_RISK_THRESHOLD=50
# เปิดงานตั้งเวลาเช็กกลุ่มเสี่ยงอัตโนมัติวันละครั้ง (ต้องติดตั้ง APScheduler ก่อน)
# เปิดเมื่อรัน uvicorn worker เดียวเท่านั้น ไม่งั้นอีเมลจะถูกส่งซ้ำตามจำนวน worker
NOTIFY_SCHEDULER_ENABLED=false
NOTIFY_AT_RISK_HOUR=8
# เวลาไทยที่ส่งอีเมลเตือน "พรุ่งนี้มีกิจกรรม" ให้คนที่สมัครไว้ (รอบเดียวกับ scheduler ด้านบน)
NOTIFY_ACTIVITY_REMINDER_HOUR=18
